APP_NAME=SENTRA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sentra.ge

APP_LOCALE=ka
APP_FALLBACK_LOCALE=ka

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# MySQL on the host (confirm database name, user and socket/host in DirectAdmin)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="info@sentra.ge"
MAIL_FROM_NAME="${APP_NAME}"

# Sanctum bearer token lifetime in minutes
SANCTUM_TOKEN_EXPIRATION=43200

SMS_DRIVER=ubill
UBILL_API_KEY=
UBILL_BRAND_ID=

# Used by db:seed to create/find the admin user
ADMIN_PHONE=
ADMIN_PASSWORD=

NEOTECH_PRODUCTS_URL=https://shop.neotech.ge/data/products.json
NEOTECH_CATEGORIES_URL=https://shop.neotech.ge/data/category.json
NEOTECH_TIMEOUT=60
